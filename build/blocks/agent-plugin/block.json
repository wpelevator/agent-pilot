{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "agent-pilot/agent-plugin",
  "title": "Agent Plugin",
  "category": "text",
  "icon": "admin-plugins",
  "description": "Author a portable Agent Plugin.",
  "textdomain": "wpelevator-agent-pilot",
  "usesContext": [
    "postId",
    "postType"
  ],
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "render": "file:./block.php",
  "attributes": {
    "author": {
      "type": "object"
    },
    "license": {
      "type": "string"
    },
    "extensions": {
      "type": "object",
      "default": {}
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "inserter": false
  }
}