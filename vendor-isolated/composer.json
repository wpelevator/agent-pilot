{
	"minimum-stability": "dev",
	"prefer-stable": true,
	"optimize-autoloader": true,
	"config": {
		"platform": {
			"php": "7.4"
		},
		"autoloader-suffix": "WPElevatorAgentPilotVendor",
		"sort-packages": true,
		"allow-plugins": {
			"wpelevator/vendor-isolator": true
		},
		"vendor-isolator": {
			"prefix": "WPElevator\\Agent_Pilot_Vendor"
		}
	},
	"require": {
		"wpelevator/update-client": "^0.4",
		"wpelevator/vendor-isolator": "^0.1"
	}
}
